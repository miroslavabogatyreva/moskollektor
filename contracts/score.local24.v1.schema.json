{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "score.local24.v1.schema.json",
  "title": "Archived section-level 24-hour candidate score",
  "description": "Product picket IDs, not object-tree nodes. Runtime also checks unique IDs, vector width/order, deterministic ranking, midnight, watermark, model identity and HTTP parity. Top10 does not change risk_class or create orders.",
  "type": "object",
  "required": ["schema_version", "feature_schema", "object_level", "horizon_h", "model_version", "model_sha256", "as_of", "timezone", "archive", "data_watermark", "recommended_budget", "feature_names", "sections"],
  "properties": {
    "schema_version": {"const": "score.local24.v1"},
    "feature_schema": {"const": "feat.local24.v1"},
    "object_level": {"const": "section"},
    "horizon_h": {"const": 24},
    "timezone": {"const": "Europe/Moscow"},
    "archive": {"const": true},
    "recommended_budget": {"const": 10},
    "model_version": {"type": "string", "minLength": 1},
    "model_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "as_of": {"type": "string"},
    "data_watermark": {"type": "string"},
    "feature_names": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "sections": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["section_id", "collector_id", "p", "rank", "features"],
        "properties": {
          "section_id": {"type": "integer", "minimum": 1},
          "collector_id": {"type": "integer", "minimum": 1},
          "rank": {"type": "integer", "minimum": 1},
          "p": {"type": "number", "minimum": 0, "maximum": 1},
          "features": {"type": "array", "items": {"type": ["number", "null"]}}
        }
      }
    }
  }
}

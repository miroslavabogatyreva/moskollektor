# Демо-стенд, открытый снаружи (задача 1.10, MOS-109). Скопировать в deploy/demo.env
# и поднимать вторым проектом compose рядом с основным стендом:
#   docker compose -p moskollektor-demo --env-file demo.env --profile app up -d api nginx
# Весь порядок, от копии базы до сертификата, — deploy/README.md, раздел «Демо-стенд».
#
# Демо смотрит в интернет, поэтому три отличия от основного стенда:
# вход только по паролю (AUTH_TRUST_HEADER=0), подсказка четырёх учёток
# на экране входа (AUTH_DEMO_HINTS=1) и сертификат Let's Encrypt, которому
# браузер доверяет без предупреждения.

# Имя, по которому демо открывают. sslip.io отдаёт на имя вида 1-2-3-4.sslip.io
# адрес 1.2.3.4 — ни покупки домена, ни правки /etc/hosts. Сертификат на это
# имя выпускает deploy/demo-cert.sh.
DEMO_HOST=135-106-216-101.sslip.io

# Порты: 80 и 443 заняты основным стендом.
HTTP_PORT=8080
HTTPS_PORT=8443
DB_PORT=5433
CERTS_DIR=./nginx/certs-demo

# База — копия основной, развёрнутая из её ночной копии кластера. Пароль
# едет вместе с кластером, поэтому он ТОТ ЖЕ, что в deploy/.env.
POSTGRES_DB=moskollektor
POSTGRES_USER=moskollektor
POSTGRES_PASSWORD=

# Свой ключ подписи куки, не основного стенда: openssl rand -hex 32.
AUTH_SECRET=
AUTH_TRUST_HEADER=0
AUTH_DEMO_HINTS=1

# Четыре демо-учётки — те, что подсказывает экран входа (backend/app/api/auth.py,
# DEMO_ACCOUNTS). Пароли открытые нарочно: демо показывают комиссии.
#   dispatcher1 / dispatcher123  — диспетчер: свой район
#   ods1        / ods123456      — диспетчер ОДС: весь парк
#   tech1       / tech123456     — техник: свой комплекс
#   admin1      / admin123456    — администратор ИС: настройки и журнал

# worker, эмулятор и модель в демо не поднимаются: показываем прогноз на момент
# копии, а не живой расчёт. Переменные ниже нужны только чтобы compose разобрал файл.
ML_IMAGE=moskollektor/ml-stub:latest
ML_URL=http://ml:8100
TZ=Europe/Moscow
LDAP_URI=
BACKUP_KEEP=1

# Редирект с http на https с внешним портом https (задача 1.10). Из этого шаблона
# образ nginx при старте пишет /etc/nginx/conf.d/https-redirect.conf, подставляя
# HTTPS_PORT из окружения контейнера; $host и $request_uri — переменные самого nginx,
# их подстановка не трогает. Основной стенд: 443. Демо: 8443 — без порта в адресе
# редирект с 8080 уводил на основной стенд.
return 301 https://$host:${HTTPS_PORT}$request_uri;

# Образец переменных стенда. Скопировать в deploy/.env и заполнить.
# Сам .env в git не идёт — правило стоит в .gitignore в корне проекта.

# База. Пароль генерируем при развёртывании: openssl rand -hex 16. Пустой — compose
# откажется поднимать стенд и назовёт переменную (задача 1.6, MOS-82).
POSTGRES_DB=moskollektor
POSTGRES_USER=moskollektor
POSTGRES_PASSWORD=

# Модель. До появления обученной модели здесь стоит заглушка из Q7.3 (MOS-66),
# дальше — образ Николая.
ML_IMAGE=moskollektor/ml-stub:latest
ML_URL=http://ml:8100

# Время. Журналы СМВУ и смены ОДС идут по Москве, расчёт тоже.
TZ=Europe/Moscow

# Планировщик (Q3.4, интервал изменён в Q3.14 / MOS-146). Интервал в минутах
# между прогонами расчёта. Часа не хватает: ТЗ разд. 9 требует, чтобы задержка
# обработки потоковых данных не превышала 300 секунд, а при часовом интервале
# показание, пришедшее в 11:01, попадает в расчёт в 12:00 — ждёт 3 540 секунд.
# При четырёх минутах худший случай — 240 с ожидания плюс 33 с самого расчёта,
# то есть 273 с против норматива 300. Занятость воркера при этом 13,6 %.
SCHEDULER_INTERVAL_MIN=4
# Отдельное задание планировщика — только свёртка, без полного расчёта.
# Закрывает НФ-73 (задержка показания до расчёта не больше 300 с).
SCHEDULER_REFRESH_INTERVAL_MIN=5
# Токен приёма потока СМВУ (MOS-37): его шлёт эмулятор СМВУ и проверяет
# POST /api/ingest/readings. Не короче 32 символов: openssl rand -hex 32.
INGEST_TOKEN=
# Погода раз в час (Ф-85, MOS-36). Пусто — эмулятор Open-Meteo на api, он отдаёт
# настоящую погоду за период выгрузки. Живой Open-Meteo бесплатен только для
# некоммерческого использования: заказчику нужна подписка или своя копия сервера.
# WEATHER_URL=https://archive-api.open-meteo.com/v1/archive
# Статусы заявок из системы учёта заказчика раз в 10 минут (Ф-87, НФ-69, MOS-63).
ORDER_STATUS_INTERVAL_MIN=10
# Пусто — эмулятор хелпдеска на api (он же Django-хелпдеск заказчика, только
# эмулируемый: реальной интеграции с ним не будет, ОВ-50). Подставить сюда
# настоящий хелпдеск — код не меняется, только чтение (НФ-69).
# ORDER_SYSTEM_URL=https://helpdesk.заказчик/v1/tickets

# Вход по логину и паролю (MOS-39, Q4.2). AUTH_SECRET — ключ подписи куки
# mk_session (HMAC-SHA256), без него api не стартует. Сгенерировать при
# развёртывании: openssl rand -hex 32 — не вписывать сюда настоящий ключ.
# Пустой — compose откажется поднимать стенд: заглушкой куки подписал бы кто угодно.
AUTH_SECRET=
# 0 — заголовок X-User-Login не заменяет вход по паролю (эксперту 401 на
# подделку). 1 — наш стенд, чтобы старые проверки на заголовке продолжали
# работать (docs/HLD.md разд. 3.5).
AUTH_TRUST_HEADER=0
# 1 — на странице входа таблица демо-учёток (логин/пароль/роль/что видит).
# В эксплуатации — 0.
AUTH_DEMO_HINTS=1

# Служба каталогов (LDAP/AD, ТЗ разд. 11). Пусто — вход только по локальным
# учётным записям. Наш демо-каталог (профиль compose ldap) слушает по имени
# сервиса ldap внутри сети compose; для AD заказчика подставить его uri,
# base DN и шаблон DN вместо демонстрационных.
LDAP_URI=ldap://ldap:389
LDAP_BASE_DN=dc=moskollektor,dc=local
LDAP_USER_TEMPLATE=uid={login},ou=people,dc=moskollektor,dc=local

# Резервные копии (задачи 1.2 и 1.18, deploy/backup.sh). Во сколько по TZ снимать
# копию кластера и сколько последних хранить. Архив WAL хранится от самой старой
# копии. 1 — по замеру журнала за сутки и 33 ГБ свободного места на стенде
# (28.09.2026): две копии в пике не помещаются. Своё число для другого диска
# печатает deploy/wal-rate.sh, docs/restore.md, «Сколько хранить».
BACKUP_AT=02:00
BACKUP_KEEP=1

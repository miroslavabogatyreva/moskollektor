%% Сервис прогнозирования аварий АО «Москоллектор» — компоненты и потоки
%% Источник: HLD.md, раздел 1. Наружу торчит один порт — 443.
flowchart TB
    subgraph ARM["АРМ диспетчера ОДС · браузер"]
        SPA["Vite + Preact + TypeScript<br/>три экрана: дашборд, карта, журнал<br/>Leaflet 42 КБ, без WebGL"]
    end

    subgraph HOST["Сервер заказчика · один хост · Docker"]
        direction TB
        NGINX["<b>nginx</b> :80 / :443<br/>статика, прокси, тайлы<br/>HTTP/2, brotli"]
        API["<b>api</b> :8000<br/>FastAPI + uvicorn<br/>REST и поток событий SSE"]
        WRK["<b>worker</b> · тот же образ<br/>APScheduler, стадии расчёта,<br/>загрузчики, DuckDB"]
        ML["<b>ml</b> :8100<br/>образ ML-команды<br/>инференс POST /predict"]
        DB[("<b>db</b> :5432<br/>PostgreSQL 18 + PostGIS<br/>smvu · feat · pred · geo<br/>ref · asset · maint · permit")]
        VOL[("тома<br/>pgdata · tiles · parquet<br/>uploads · backups")]
    end

    subgraph SRC["Источники заказчика"]
        S1["СМВУ · выгрузки .xlsx за 12 лет"]
        S2["Журналы ОДС"]
        S3["АРМ-Контроль · реестр допусков"]
        S4["Реестр оборудования ОЭ"]
    end

    SPA -- "HTTPS/2 · GET /api/v1/* · SSE · тайлы" --> NGINX
    NGINX -- "proxy_pass HTTP/1.1" --> API
    NGINX -- "файлы с тома" --> VOL
    API -- "asyncpg · пул 10" --> DB
    WRK -- "asyncpg · пул 4" --> DB
    WRK -- "POST /predict · JSON колонками" --> ML
    ML -. "вероятность, вклад признаков, версия модели" .-> WRK
    WRK -- "NOTIFY forecast_ready" --> DB
    DB -- "LISTEN → кадр SSE" --> API
    WRK -- "Parquet: архив и метки для обучения" --> VOL
    S1 -. "способ доставки не согласован" .-> WRK
    S2 -.-> WRK
    S3 -.-> WRK
    S4 -.-> WRK

    classDef ours fill:#E8EEF7,stroke:#003882,stroke-width:2px,color:#15202B
    classDef theirs fill:#F7EFE4,stroke:#B35C00,stroke-width:2px,color:#15202B
    classDef store fill:#EDEFF2,stroke:#7D8894,stroke-width:1px,color:#15202B
    classDef ext fill:#F4F6F8,stroke:#C9D0D8,stroke-dasharray:4 3,color:#47525E
    class SPA,NGINX,API,WRK ours
    class ML theirs
    class DB,VOL store
    class S1,S2,S3,S4 ext

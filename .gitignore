# Системное и временное
.DS_Store
__pycache__/
*.pyc
venv/
.venv/

# Выгрузки заказчика: 13 ГБ csv и 1,6 ГБ архивов, в репозиторий не кладём
dataset/

# Книги и стандарты: 10 PDF, 101 МБ. Лежат на сервере в
# /srv/moskollektor-hakaton-data/books, забираются rsync-ом — см. docs/server.md.
# Наши разборы книг (docs/books/*.md) в git остаются, правило их не задевает.
docs/books/*.pdf

# Временные файлы Word и PowerPoint рядом с открытым документом
~$*

# Переменные стенда: в них пароль базы. Образец без значений —
# deploy/.env.example, он в git идёт.
deploy/.env

# Самоподписанный сертификат стенда и приватный ключ к нему.
# Пересоздаются командой `sh deploy/make-cert.sh` за две секунды.
deploy/nginx/certs/

# Собранный фронт на стенде: его кладёт deploy/deploy.sh из frontend/dist.
# Отдельно от заглушки deploy/nginx/html, которую держит git (задача 1.11).
deploy/nginx/app/

# Демо-стенд (задача 1.10): переменные с паролями, сертификат Let's Encrypt,
# его рабочий каталог certbot и проверочные файлы. Образец — deploy/demo.env.example.
deploy/demo.env
deploy/nginx/certs-demo/
deploy/nginx/letsencrypt/
deploy/nginx/acme/

# Промежуточный счёт analysis/inventory.py по восьми годовым файлам:
# восемь .tsv, пересоздаются проходом по dataset/ за 7 минут.
inventory_scan/

# Фронт: зависимости и сборка, пересоздаются npm install / npm run build
frontend/node_modules/
frontend/dist/
# Playwright: отчёт и трассы упавших тестов, пересоздаются npm run e2e
frontend/test-results/
frontend/playwright-report/

# Локальные разрешения Claude Code, у каждого свои.
.claude/settings.local.json

# Снимки экранов и слепки страниц, которые пишет браузерный сервер Playwright
# во время проверки строк приёмки. Доказательства живут в переписке и в строках
# docs/acceptance-test.md, а не в git: за один проход цикла М-12 набежало 344 КБ.
.playwright-mcp/
# Пакет сдачи, собирает delivery/pack.sh (MOS-125).
/dist/

# Локальный мусор, в сдачу не идёт: служебные каталоги чужих агентов (crush, zcode),
# вложения задачи MOS-74 (11 МБ), черновик PRD и соседний рабочий каталог
# moskollektor-wt/ (3,3 ГБ копия репозитория).
.crush/
.zcode/
MOS-74_attachments/
moskollektor-wt/
/PRD_*.md

# Внутренние рабочие документы, экспертам не нужны; на диске остаются (MOS-266).
docs/review/
docs/workflow.md
docs/typical-composition-of-the-security-system-of-urban-sewers.md
